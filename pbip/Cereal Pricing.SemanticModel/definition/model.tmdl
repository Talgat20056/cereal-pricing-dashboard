model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder", "Sales", "Product", "Store", "Calendar", "Brand"]

annotation PBI_ProTooling = ["DevMode"]

ref table Sales
ref table Product
ref table Store
ref table Calendar
ref table Brand
ref table 'Price Change %'
ref table 'Pricing Measures'

